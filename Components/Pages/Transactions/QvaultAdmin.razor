@page "/tx/qvault"
@inject QubicBackendService Backend
@inject SeedSessionService Seed
@inject TickMonitorService TickMonitor
@inject TransactionTrackerService TxTracker
@inject QubicSettingsService Settings

<h4>QVault (Staking &amp; Governance)</h4>
<p class="text-muted">Stake QCAP, submit and vote on QVault proposals, buy QCAP.</p>

@if (!Seed.HasSeed)
{
    <div class="seed-warning">Enter your seed in the top bar to enable signing.</div>
}
else
{
    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in _tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(tab == _activeTab ? "active" : "")" href="" @onclick="() => _activeTab = tab" @onclick:preventDefault>@tab</a>
            </li>
        }
    </ul>

    <div class="row"><div class="col-md-8">
        @switch (_activeTab)
        {
            case "Stake":
                <div class="card"><div class="card-header">Stake / Unstake QCAP</div><div class="card-body">
                    <div class="mb-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="stakeMode" checked="@(_stakeAction == ActionStake)" @onchange="() => _stakeAction = ActionStake" />
                            <label class="form-check-label">Stake</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="stakeMode" checked="@(_stakeAction == ActionUnstake)" @onchange="() => _stakeAction = ActionUnstake" />
                            <label class="form-check-label">Unstake</label>
                        </div>
                    </div>
                    <div class="mb-2"><label class="form-label-sm">Amount (QCAP)</label>
                        <input type="number" class="form-control form-control-sm" min="1" @bind="_stakeAmount" /></div>
                    <button class="btn btn-primary" @onclick="StakeOp" disabled="@_sending">@(_sending ? "Sending..." : (_stakeAction == ActionStake ? "Stake" : "Unstake"))</button>
                </div></div>
                break;

            case "Buy QCAP":
                <div class="card"><div class="card-header">Buy QCAP</div><div class="card-body">
                    <div class="mb-2"><label class="form-label-sm">Amount (QCAP)</label>
                        <input type="number" class="form-control form-control-sm" min="1" @bind="_buyAmount" /></div>
                    <button class="btn btn-primary" @onclick="BuyQcap" disabled="@_sending">@(_sending ? "Sending..." : "Buy QCAP")</button>
                </div></div>
                break;

            case "Submit Proposal":
                <div class="card"><div class="card-header">Submit Proposal</div><div class="card-body">
                    <div class="mb-2">
                        <label class="form-label-sm">Proposal Type</label>
                        <select class="form-select form-select-sm" @bind="_propType">
                            <option value="GP">General Proposal (GP)</option>
                            <option value="QCP">Quorum Change (QCP)</option>
                            <option value="IPOP">IPO Proposal (IPOP)</option>
                            <option value="QEarnP">QEarn Proposal (QEarnP)</option>
                            <option value="FundP">Fund Proposal (FundP)</option>
                            <option value="MKTP">Market Proposal (MKTP)</option>
                            <option value="AlloP">Allocation Proposal (AlloP)</option>
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label-sm">URL (max 256 bytes)</label>
                        <input class="form-control form-control-sm" maxlength="256" @bind="_propUrl" /></div>

                    @switch (_propType)
                    {
                        case "QCP":
                            <div class="mb-2"><label class="form-label-sm">New Quorum Percent</label>
                                <input type="number" class="form-control form-control-sm" min="0" max="100" @bind="_qcpPercent" /></div>
                            break;
                        case "IPOP":
                            <div class="mb-2"><label class="form-label-sm">IPO Contract Index</label>
                                <input type="number" class="form-control form-control-sm" min="0" @bind="_ipoContractIndex" /></div>
                            break;
                        case "QEarnP":
                            <div class="row g-2 mb-2">
                                <div class="col"><label class="form-label-sm">Amount per Epoch</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_qearnAmountPerEpoch" /></div>
                                <div class="col"><label class="form-label-sm">Number of Epochs</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_qearnEpochs" /></div>
                            </div>
                            break;
                        case "FundP":
                            <div class="row g-2 mb-2">
                                <div class="col"><label class="form-label-sm">Price per QCAP</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_fundPrice" /></div>
                                <div class="col"><label class="form-label-sm">Amount of QCAP</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_fundAmount" /></div>
                            </div>
                            break;
                        case "MKTP":
                            <div class="row g-2 mb-2">
                                <div class="col"><label class="form-label-sm">Amount of Qubic</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_mktAmountQubic" /></div>
                                <div class="col"><label class="form-label-sm">Share Name (u64)</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_mktShareName" /></div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col"><label class="form-label-sm">Amount of QCAP</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_mktAmountQcap" /></div>
                                <div class="col"><label class="form-label-sm">Index of Share</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_mktShareIndex" /></div>
                                <div class="col"><label class="form-label-sm">Amount of Share</label>
                                    <input type="number" class="form-control form-control-sm" min="0" @bind="_mktShareAmount" /></div>
                            </div>
                            break;
                        case "AlloP":
                            <p class="small text-muted">Reinvested + Burn + Distribute must total 970 permille.</p>
                            <div class="row g-2 mb-2">
                                <div class="col"><label class="form-label-sm">Reinvested</label>
                                    <input type="number" class="form-control form-control-sm" min="0" max="970" @bind="_alloReinvest" /></div>
                                <div class="col"><label class="form-label-sm">Burn</label>
                                    <input type="number" class="form-control form-control-sm" min="0" max="970" @bind="_alloBurn" /></div>
                                <div class="col"><label class="form-label-sm">Distribute</label>
                                    <input type="number" class="form-control form-control-sm" min="0" max="970" @bind="_alloDistribute" /></div>
                            </div>
                            <div class="small text-muted mb-2">Sum: @(_alloReinvest + _alloBurn + _alloDistribute)</div>
                            break;
                    }
                    <button class="btn btn-primary" @onclick="SubmitProposal" disabled="@_sending">@(_sending ? "Submitting..." : $"Submit {_propType}")</button>
                </div></div>
                break;

            case "Vote":
                <div class="card"><div class="card-header">Vote In Proposal</div><div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col"><label class="form-label-sm">Proposal Type (u32)</label>
                            <input type="number" class="form-control form-control-sm" min="0" @bind="_voteType" /></div>
                        <div class="col"><label class="form-label-sm">Proposal ID</label>
                            <input type="number" class="form-control form-control-sm" min="0" @bind="_voteProposalId" /></div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col"><label class="form-label-sm">Price of IPO (only for IPOP)</label>
                            <input type="number" class="form-control form-control-sm" min="0" @bind="_votePriceOfIpo" /></div>
                        <div class="col d-flex align-items-end">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" @bind="_voteYes" />
                                <label class="form-check-label">Yes</label>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-primary" @onclick="VoteOnProposal" disabled="@_sending">@(_sending ? "Sending..." : "Vote")</button>
                </div></div>
                break;
        }

        @if (_result != null)
        {
            <div class="alert alert-success mt-3">
                Transaction broadcast! Tx ID: <span class="mono">@_result</span>
                <div class="mt-1">
                    <a href="https://explorer.qubic.org/network/tx/@_result" target="_blank" rel="noopener" class="me-3">View on Explorer</a>
                    <a href="/tx/history">Transaction History</a>
                </div>
            </div>
        }
        @if (_error != null) { <div class="alert alert-danger mt-2">@_error</div> }
    </div></div>
}

@code {
    private const string ActionStake = "stake";
    private const string ActionUnstake = "unstake";

    private static readonly string[] _tabs = ["Stake", "Buy QCAP", "Submit Proposal", "Vote"];
    private string _activeTab = "Stake";
    private bool _sending;
    private string? _result;
    private string? _error;
    private const int ContractIndex = 10;

    // Stake
    private string _stakeAction = ActionStake; private uint _stakeAmount;
    // Buy
    private uint _buyAmount;
    // Proposal
    private string _propType = "GP";
    private string _propUrl = "";
    private uint _qcpPercent;
    private uint _ipoContractIndex;
    private ulong _qearnAmountPerEpoch; private uint _qearnEpochs;
    private ulong _fundPrice; private uint _fundAmount;
    private ulong _mktAmountQubic; private ulong _mktShareName;
    private uint _mktAmountQcap; private uint _mktShareIndex; private uint _mktShareAmount;
    private uint _alloReinvest; private uint _alloBurn; private uint _alloDistribute;
    // Vote
    private uint _voteType; private uint _voteProposalId; private ulong _votePriceOfIpo; private bool _voteYes;

    private async Task<uint> GetTick() => TickMonitor.IsConnected
        ? TickMonitor.Tick + (uint)Settings.TickOffset
        : (await Backend.GetTickInfoAsync()).Tick + (uint)Settings.TickOffset;

    private async Task Broadcast(long amount, uint tick, Qubic.Core.Payloads.ITransactionPayload payload, string desc)
    {
        var dest = Qubic.Core.Entities.QubicIdentity.FromPublicKey(Qubic.Core.QubicContracts.GetContractPublicKey(ContractIndex));
        var tx = Seed.CreateAndSignTransaction(dest, amount, tick, payload);
        var result = await Backend.BroadcastTransactionAsync(tx);
        _result = result.TransactionId;
        TxTracker.Track(new TrackedTransaction { Hash = result.TransactionId, Source = Seed.Identity?.ToString() ?? "",
            Destination = dest.ToString(), Amount = amount, TargetTick = tick,
            InputType = payload.InputType, PayloadHex = Convert.ToHexString(payload.GetPayloadBytes()), Description = desc });
    }

    private static byte[] UrlBytes(string url)
        => System.Text.Encoding.UTF8.GetBytes(url ?? "");

    private async Task StakeOp()
    {
        _sending = true; _error = null; _result = null;
        try
        {
            if (_stakeAmount == 0) { _error = "Amount must be positive."; return; }
            var tick = await GetTick();
            Qubic.Core.Payloads.ITransactionPayload payload = _stakeAction == ActionStake
                ? new Qubic.Core.Contracts.Qvault.StakePayload { Amount = _stakeAmount }
                : new Qubic.Core.Contracts.Qvault.UnStakePayload { Amount = _stakeAmount };
            await Broadcast(0, tick, payload, $"QVault {_stakeAction} {_stakeAmount:N0} QCAP");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sending = false; }
    }

    private async Task BuyQcap()
    {
        _sending = true; _error = null; _result = null;
        try
        {
            if (_buyAmount == 0) { _error = "Amount must be positive."; return; }
            var tick = await GetTick();
            var payload = new Qubic.Core.Contracts.Qvault.BuyQcapPayload { Amount = _buyAmount };
            await Broadcast(0, tick, payload, $"QVault Buy {_buyAmount:N0} QCAP");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sending = false; }
    }

    private async Task SubmitProposal()
    {
        _sending = true; _error = null; _result = null;
        try
        {
            var url = UrlBytes(_propUrl);
            var tick = await GetTick();
            Qubic.Core.Payloads.ITransactionPayload payload = _propType switch
            {
                "GP" => new Qubic.Core.Contracts.Qvault.SubmitGPPayload { Url = url },
                "QCP" => new Qubic.Core.Contracts.Qvault.SubmitQCPPayload { NewQuorumPercent = _qcpPercent, Url = url },
                "IPOP" => new Qubic.Core.Contracts.Qvault.SubmitIPOPPayload { IpoContractIndex = _ipoContractIndex, Url = url },
                "QEarnP" => new Qubic.Core.Contracts.Qvault.SubmitQEarnPPayload { AmountPerEpoch = _qearnAmountPerEpoch, NumberOfEpoch = _qearnEpochs, Url = url },
                "FundP" => new Qubic.Core.Contracts.Qvault.SubmitFundPPayload { PriceOfOneQcap = _fundPrice, AmountOfQcap = _fundAmount, Url = url },
                "MKTP" => new Qubic.Core.Contracts.Qvault.SubmitMKTPPayload
                {
                    AmountOfQubic = _mktAmountQubic, ShareName = _mktShareName,
                    AmountOfQcap = _mktAmountQcap, IndexOfShare = _mktShareIndex, AmountOfShare = _mktShareAmount,
                    Url = url
                },
                "AlloP" => new Qubic.Core.Contracts.Qvault.SubmitAlloPPayload
                    { Reinvested = _alloReinvest, Burn = _alloBurn, Distribute = _alloDistribute, Url = url },
                _ => throw new ArgumentException($"Unknown proposal type {_propType}")
            };
            await Broadcast(0, tick, payload, $"QVault Submit {_propType} proposal");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sending = false; }
    }

    private async Task VoteOnProposal()
    {
        _sending = true; _error = null; _result = null;
        try
        {
            var tick = await GetTick();
            var payload = new Qubic.Core.Contracts.Qvault.VoteInProposalPayload
            {
                PriceOfIPO = _votePriceOfIpo,
                ProposalType = _voteType,
                ProposalId = _voteProposalId,
                Yes = _voteYes
            };
            await Broadcast(0, tick, payload, $"QVault Vote on proposal {_voteProposalId} (type {_voteType}): {(_voteYes ? "YES" : "NO")}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sending = false; }
    }
}
