    private async Task TransferToken()
    {
        _sending = true; _error = null; _result = null;
        try
        {
            var err = IdentityValidation.Validate(_transferReceiver);
            if (err != null) { _error = err; return; }
            if (_transferAmount <= 0) { _error = "Amount must be positive."; return; }
            var pk = Qubic.Core.Entities.QubicIdentity.FromIdentity(_transferReceiver.Trim()).PublicKey;
            var tick = await GetTick();
            Qubic.Core.Payloads.ITransactionPayload payload = _transferToken == "qusd"
                ? new Qubic.Core.Contracts.Quottery.TransferQUSDPayload { Receiver = pk, Amount = _transferAmount }
                : new Qubic.Core.Contracts.Quottery.TransferQTRYGOVPayload { Receiver = pk, Amount = _transferAmount };
            await Broadcast(0, tick, payload, $"Quottery transfer {_transferToken.ToUpperInvariant()} {_transferAmount:N0} to {_transferReceiver.Trim()[..8]}...");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sending = false; }
    }
